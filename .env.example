# 应用配置模板
# 本文件仅作参考：实际配置由安装向导生成于 data/config.php
# 请勿将包含真实密钥的 data/config.php 提交到版本库

# 安装标记（安装向导写入 true）
installed: true

# 应用加密密钥（安装时自动生成，base64: 开头；用于 AES-256-GCM 加密上游密钥）
app_key: "base64:REPLACE_ME_BASE64_RANDOM_32_BYTES"

# Cron 外部触发 Token（安装时自动生成）
cron_token: "REPLACE_ME_RANDOM_HEX"

# 数据库（二选一）
database:
  # MySQL 示例
  driver: mysql
  host: localhost
  port: 3306
  database: sub2api
  username: sub2api
  password: "REPLACE_ME"
  # SQLite 示例
  # driver: sqlite
  # sqlite_path: /abs/path/data/sub2api.db
